<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude SPRING_ENDPOINT detections - these are intentional Spring REST endpoints -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    
    <!-- Exclude false positives for records and modern Java features -->
    <Match>
        <Class name="~.*\$\$Lambda.*"/>
    </Match>
    
    <!-- Suppress warnings about synthetic methods generated by Java compiler -->
    <Match>
        <Method name="~(toString|typeSwitch|apply|makeConcatWithConstants|accept|test|customize)"/>
    </Match>
    
    <!-- Exclude IMPROPER_UNICODE for LoadResourceProvider.formatLoadInfo - we use Locale.ROOT explicitly -->
    <Match>
        <Class name="ca.zhoozhoo.loaddev.mcp.provider.LoadResourceProvider"/>
        <Method name="formatLoadInfo"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>
    
    <!-- Exclude MapStruct-generated mapper implementations - false positives on generated code -->
    <Match>
        <Class name="~.*MapperImpl"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Exclude NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE false positives in LoadsService/RiflesService.
         Authentication is safely null-checked via Mono.justOrEmpty(...).switchIfEmpty(Mono.error(...))
         before being passed to the downstream flatMap/flatMapMany lambda, but SpotBugs cannot correlate
         the null-check across separate lambda boundaries in the reactive chain. -->
    <Match>
        <Or>
            <Class name="ca.zhoozhoo.loaddev.mcp.service.LoadsService"/>
            <Class name="ca.zhoozhoo.loaddev.mcp.service.RiflesService"/>
        </Or>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>
</FindBugsFilter>
